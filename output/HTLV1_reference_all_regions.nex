#NEXUS
[ Reference HTLV-1 sequence with all annotated regions ]

begin data;
  dimensions ntax=1 nchar=8479;
  format datatype=dna gap=- missing=?;
  matrix
    HTLV1_reference     
  ;
end;

begin sets;
  [ Individual feature charsets for partitioning ]
  charset 5LTR = 1-755;
  charset gag-pro-pol_1 = 756-2045;
  charset gag-pro-pol_2 = 2046-4619;
  charset env = 4620-6086;
  charset HBZ = 6087-6716;
  charset Tax = 6717-7724;
  charset 3LTR = 7725-8479;
end;

begin partition;
  [ Partitioning scheme for phylogenetic inference ]
  partition HTLV1_regions = 1:5LTR, 2:gag-pro-pol_1, 3:gag-pro-pol_2, 4:env, 5:HBZ, 6:Tax, 7:3LTR;
end;
