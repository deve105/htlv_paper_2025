% use inch as unit
/inch {72 mul} def
% triangle side length (3 inch)
/tl {3 inch mul} def
% plot one dot (x-y coordinates on stack)
/dot {
newpath
0.002 tl 0 360 arc  % radius is 0.002 of the triangle length
closepath
fill
} def

% flush right show
/centershow {
   dup stringwidth pop  % get length of string
   neg 0 rmoveto        % move width to left
   show
} def

% centered show
/centershow {
   dup stringwidth pop % get length of string
   -2 div              % devide length by -2
   0 rmoveto           % move half width to left
   show
} def
% preamble
/Helvetica findfont
12 scalefont
setfont
% 0/0 for triangle of triangles
0.9 inch 3 inch translate
% first triangle (the one with dots)
0.6 tl 1.2 tl 0.8660254038 mul translate
newpath
 0.0 tl 0.0 tl moveto
 1.0 tl 0.0 tl lineto
 0.5 tl 0.8660254038 tl lineto
closepath
